# Copy this file to `.env` (same folder) and fill in your own values.
# `.env` is private and ignored by git. Never put real keys in this file.
# The server reads `.env` when it starts (npm start / npm run dev).

PORT=3000

# REQUIRED in production: long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=30d

# SQLite file path (use :memory: for throwaway)
DATABASE_PATH=./data/prism.db

# Google link check (POST /api/scans/webrisk) through the Google Cloud Web Risk API.
# API key from Google Cloud Console (APIs & Services > Credentials) with the Web Risk API enabled.
# Paste it here, or enter it in the app (admin menu > Google API key): the app writes it to this file.
# Leave empty to turn the link check off.
WEB_RISK_API_KEY=
